<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Red's Tracker — Insurance Department Operations & Performance Hub</title>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-alt: #273549;
      --border: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --accent: #10b981;
      --accent-hover: #059669;
      --warning: #f59e0b;
      --danger: #ef4444;
      --radius: 10px;
      --shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      min-height: 100vh;
    }

    /* Header & Navigation */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 1rem 1.5rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow);
    }

    .header-top {
      max-width: 1280px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .brand h1 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: 0.3px;
      color: #fff;
    }

    .brand p {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    nav.tabs {
      max-width: 1280px;
      margin: 1rem auto 0;
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .tab-btn {
      background: var(--surface-alt);
      color: var(--text-muted);
      border: 1px solid var(--border);
      padding: 0.6rem 1.1rem;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      font-size: 0.9rem;
      white-space: nowrap;
      transition: all 0.2s ease;
    }

    .tab-btn:hover {
      color: #fff;
      border-color: var(--primary);
    }

    .tab-btn.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
    }

    main {
      max-width: 1280px;
      margin: 1.5rem auto;
      padding: 0 1.25rem 3rem;
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Cards & Grid */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem;
      margin-bottom: 1.25rem;
      box-shadow: var(--shadow);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.25rem;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1rem;
    }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    /* Form Controls */
    label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      margin-bottom: 0.35rem;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    input[type="text"],
    input[type="number"],
    input[type="date"],
    input[type="email"],
    select,
    textarea {
      width: 100%;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 0.55rem 0.75rem;
      font-size: 0.92rem;
      transition: border-color 0.2s;
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
    }

    .form-group {
      margin-bottom: 0.9rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      padding: 0.6rem 1.1rem;
      border-radius: 7px;
      border: none;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-hover); }

    .btn-accent { background: var(--accent); color: #fff; }
    .btn-accent:hover { background: var(--accent-hover); }

    .btn-outline {
      background: transparent;
      color: var(--text);
      border: 1px solid var(--border);
    }
    .btn-outline:hover {
      background: var(--surface-alt);
      border-color: var(--text-muted);
    }

    .btn-danger { background: var(--danger); color: #fff; }
    .btn-sm { padding: 0.35rem 0.7rem; font-size: 0.8rem; }

    /* Hourly Dial Grid */
    .dial-box {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.9rem;
    }

    .dial-box h4 {
      font-size: 0.9rem;
      color: #fff;
      margin-bottom: 0.65rem;
      display: flex;
      justify-content: space-between;
    }

    .dial-row {
      display: grid;
      grid-template-columns: 1fr 90px;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
    }

    /* Shift Report Card */
    .shift-card {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      transition: opacity 0.2s;
    }

    .shift-card.disabled {
      opacity: 0.55;
    }

    .shift-card-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.8rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid var(--border);
    }

    .shift-card-header input[type="checkbox"] {
      width: 18px;
      height: 18px;
      accent-color: var(--accent);
      cursor: pointer;
    }

    .shift-card-title {
      font-weight: 700;
      font-size: 0.92rem;
      color: #fff;
    }

    .mini-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }

    /* Output Box */
    .output-area {
      font-family: "Courier New", Courier, monospace;
      background: #090d16;
      color: #e2e8f0;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1rem;
      width: 100%;
      min-height: 260px;
      resize: vertical;
      font-size: 0.88rem;
      line-height: 1.45;
    }

    /* Checkboxes List */
    .check-item {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.45rem 0.6rem;
      background: var(--surface-alt);
      border-radius: 6px;
      margin-bottom: 0.45rem;
      cursor: pointer;
      font-size: 0.9rem;
    }

    .check-item input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: var(--primary);
    }

    /* Pill Shortcuts */
    .pill-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.4rem;
    }

    .pill {
      background: var(--surface-alt);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      font-size: 0.78rem;
      cursor: pointer;
    }

    .pill:hover {
      border-color: var(--primary);
      background: var(--primary);
    }

    /* KPI Cards */
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.1rem;
      text-align: center;
    }

    .kpi-label {
      font-size: 0.78rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    .kpi-value {
      font-size: 1.85rem;
      font-weight: 800;
      color: #fff;
      margin-top: 0.3rem;
    }

    .kpi-sub {
      font-size: 0.78rem;
      color: var(--accent);
      margin-top: 0.2rem;
    }

    /* Tables */
    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }

    th, td {
      padding: 0.7rem 0.85rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }

    th {
      background: var(--surface-alt);
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.76rem;
      letter-spacing: 0.4px;
    }

    tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .badge {
      display: inline-block;
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      background: rgba(59, 130, 246, 0.2);
      color: #93c5fd;
    }

    .badge-green {
      background: rgba(16, 185, 129, 0.2);
      color: #6ee7b7;
    }

    /* Toast Notification */
    #toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--accent);
      color: #fff;
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-weight: 600;
      box-shadow: var(--shadow);
      opacity: 0;
      pointer-events: none;
      transform: translateY(10px);
      transition: all 0.25s ease;
      z-index: 999;
    }

    #toast.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

<header>
  <div class="header-top">
    <div class="brand">
      <h1>Red's Tracker</h1>
      <p>Insurance Department — EOD Reports, Appointment Notes & Worked Hours Hub</p>
    </div>
    <div style="display:flex; gap:0.5rem; align-items:center;">
      <span id="storageBadge" class="badge badge-green">Auto-Saved Locally</span>
    </div>
  </div>
  <nav class="tabs">
    <button class="tab-btn active" onclick="switchTab('eod')">1. EOD Report</button>
    <button class="tab-btn" onclick="switchTab('notes')">2. Note Generator</button>
    <button class="tab-btn" onclick="switchTab('hours')">3. Hours Submission</button>
    <button class="tab-btn" onclick="switchTab('log')">4. Master Log & Summary</button>
  </nav>
</header>

<main>
  <!-- ==================== TAB 1: EOD REPORT GENERATOR ==================== -->
  <section id="tab-eod" class="tab-panel active">
    <div class="card">
      <div class="card-header">
        <span class="card-title">EOD Performance Report Setup</span>
        <div style="display:flex; gap:0.5rem; align-items:center; flex-wrap:wrap;">
          <label for="eodDate" style="margin:0;">Report Date:</label>
          <input type="date" id="eodDate" style="width:auto;" onchange="saveEodState()" />
          <button class="btn btn-outline btn-sm" onclick="resetEodCounters()">Reset Counters</button>
        </div>
      </div>

      <!-- Hourly Dial Breakdown -->
      <h3 style="font-size:0.95rem; margin-bottom:0.75rem; color:#cbd5e1;">Hourly Dial Counter Grid (Auto-Syncs Shift Dials)</h3>
      <div class="grid-3" style="margin-bottom:1.5rem;">
        <!-- Pre Shift Dials -->
        <div class="dial-box">
          <h4><span>Pre Shift (10:00 - 12:00)</span> <span id="preTotalBadge" class="badge">0 Dials</span></h4>
          <div class="dial-row">
            <span>10:00 - 11:00</span>
            <input type="number" min="0" id="d_pre_1" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>11:00 - 12:00</span>
            <input type="number" min="0" id="d_pre_2" oninput="syncHourlyDials()" />
          </div>
        </div>

        <!-- 1st Shift Dials -->
        <div class="dial-box">
          <h4><span>1st Shift (12:30 - 4:30)</span> <span id="firstTotalBadge" class="badge">229 Dials</span></h4>
          <div class="dial-row">
            <span>12:30 - 1:30 (1st Half)</span>
            <input type="number" min="0" id="d_1st_1" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>1:30 - 2:30 (1st Half)</span>
            <input type="number" min="0" id="d_1st_2" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>2:45 - 3:30 (2nd Half)</span>
            <input type="number" min="0" id="d_1st_3" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>3:30 - 4:30 (2nd Half)</span>
            <input type="number" min="0" id="d_1st_4" oninput="syncHourlyDials()" />
          </div>
        </div>

        <!-- 2nd Shift Dials -->
        <div class="dial-box">
          <h4><span>2nd Shift (5:00 - 9:00)</span> <span id="secondTotalBadge" class="badge">0 Dials</span></h4>
          <div class="dial-row">
            <span>5:00 - 6:00 (1st Half)</span>
            <input type="number" min="0" id="d_2nd_1" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>6:00 - 7:00 (1st Half)</span>
            <input type="number" min="0" id="d_2nd_2" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>7:15 - 8:00 (2nd Half)</span>
            <input type="number" min="0" id="d_2nd_3" oninput="syncHourlyDials()" />
          </div>
          <div class="dial-row">
            <span>8:00 - 9:00 (2nd Half)</span>
            <input type="number" min="0" id="d_2nd_4" oninput="syncHourlyDials()" />
          </div>
        </div>
      </div>

      <!-- 7 Shift Performance Cards -->
      <h3 style="font-size:0.95rem; margin-bottom:0.75rem; color:#cbd5e1;">Shift Report Blocks (Check Box to Include in Generated Report)</h3>
      <div id="shiftCardsContainer" class="grid-2"></div>
    </div>

    <!-- Live EOD Output -->
    <div class="card">
      <div class="card-header">
        <span class="card-title">Generated EOD Report Output</span>
        <button class="btn btn-accent" onclick="copyText('eodOutput', 'EOD Report copied to clipboard!')">Copy EOD Report</button>
      </div>
      <textarea id="eodOutput" class="output-area" readonly></textarea>
    </div>
  </section>

  <!-- ==================== TAB 2: NOTE GENERATOR ==================== -->
  <section id="tab-notes" class="tab-panel">
    <div class="grid-2">
      <!-- Left: Checkboxes & Client Details -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Appointment Note Builder</span>
          <button class="btn btn-outline btn-sm" onclick="resetNoteForm()">Reset Form</button>
        </div>

        <h4 style="font-size:0.85rem; color:var(--text-muted); margin-bottom:0.5rem;">ALERT & TIMING TAGS</h4>
        <div class="grid-2" style="gap:0.4rem; margin-bottom:1rem;">
          <label class="check-item"><input type="checkbox" class="note-tag" value="Same Day Appointment" onchange="updateNoteOutput()"> Same Day Appointment</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Next Day Appointment" checked onchange="updateNoteOutput()"> Next Day Appointment</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Verified Appointment" onchange="updateNoteOutput()"> Verified Appointment</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Preset Appointment" onchange="updateNoteOutput()"> Preset Appointment</label>
        </div>

        <h4 style="font-size:0.85rem; color:var(--text-muted); margin-bottom:0.5rem;">MEETING MODE</h4>
        <div class="grid-3" style="gap:0.4rem; margin-bottom:1rem;">
          <label class="check-item"><input type="checkbox" class="note-tag" value="Zoom Ready" onchange="updateNoteOutput()"> Zoom Ready</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="PHONE CALL" checked onchange="updateNoteOutput()"> PHONE CALL</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="with Internet access" onchange="updateNoteOutput()"> with Internet access</label>
        </div>

        <h4 style="font-size:0.85rem; color:var(--text-muted); margin-bottom:0.5rem;">MARITAL / HOUSEHOLD STATUS</h4>
        <div class="grid-2" style="gap:0.4rem; margin-bottom:1.25rem;">
          <label class="check-item"><input type="checkbox" class="note-tag" value="Single" onchange="updateNoteOutput()"> Single</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Married" onchange="updateNoteOutput()"> Married</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Living with significant other" checked onchange="updateNoteOutput()"> Living with significant other</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Divorced" onchange="updateNoteOutput()"> Divorced</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Separated" onchange="updateNoteOutput()"> Separated</label>
          <label class="check-item"><input type="checkbox" class="note-tag" value="Widowed" onchange="updateNoteOutput()"> Widowed</label>
        </div>

        <h4 style="font-size:0.85rem; color:var(--text-muted); margin-bottom:0.65rem;">CLIENT DETAILS</h4>
        <div class="grid-2" style="gap:0.75rem;">
          <div class="form-group">
            <label>Manager's Name</label>
            <input type="text" id="noteManager" value="AHMED MUSTAFA" oninput="updateNoteOutput()" />
            <div class="pill-group">
              <span class="pill" onclick="setVal('noteManager','TAMI CHAIMOV'); updateNoteOutput();">TAMI CHAIMOV</span>
              <span class="pill" onclick="setVal('noteManager','AHMED MUSTAFA'); updateNoteOutput();">AHMED MUSTAFA</span>
            </div>
          </div>
          <div class="form-group">
            <label>Lead Type</label>
            <input type="text" id="noteLeadType" value="POS" oninput="updateNoteOutput()" />
          </div>
          <div class="form-group">
            <label>State</label>
            <input type="text" id="noteState" value="WV" oninput="updateNoteOutput()" />
          </div>
          <div class="form-group">
            <label>Client Name</label>
            <input type="text" id="noteClientName" value="CATHY MCCORMICK" oninput="updateNoteOutput()" />
          </div>
          <div class="form-group">
            <label>Email</label>
            <input type="email" id="noteEmail" value="CAT.1954@HOTMAIL.COM" oninput="updateNoteOutput()" />
          </div>
          <div class="form-group">
            <label>CP# (Cell Phone)</label>
            <input type="text" id="noteCp" value="(304) 960-9253" oninput="updateNoteOutput()" />
          </div>
        </div>

        <div class="form-group">
          <label>Schedule</label>
          <input type="text" id="noteSchedule" value="8:00pm - 8:30pm, Tuesday, November 17, 2026" oninput="updateNoteOutput()" />
        </div>

        <div class="grid-2" style="gap:0.75rem;">
          <div class="form-group">
            <label>Time Zone</label>
            <select id="noteTimezone" onchange="updateNoteOutput()">
              <option value="Eastern Time - US & Canada" selected>Eastern Time - US & Canada</option>
              <option value="Central Time - US & Canada">Central Time - US & Canada</option>
              <option value="Mountain Time - US & Canada">Mountain Time - US & Canada</option>
              <option value="Pacific Time - US & Canada">Pacific Time - US & Canada</option>
            </select>
          </div>
          <div class="form-group">
            <label>Best CB # <span class="pill" style="margin-left:6px;" onclick="copyCpToCb()">Same as CP#</span></label>
            <input type="text" id="noteBestCb" value="(304) 960-9253" oninput="updateNoteOutput()" />
          </div>
        </div>
      </div>

      <!-- Right: Live Note Output -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Generated Result (Copy Below)</span>
          <button class="btn btn-accent" onclick="copyText('noteOutput', 'Appointment note copied!')">Copy Note</button>
        </div>
        <textarea id="noteOutput" class="output-area" style="min-height:420px;" readonly></textarea>
      </div>
    </div>
  </section>

  <!-- ==================== TAB 3: HOURS SUBMISSION ==================== -->
  <section id="tab-hours" class="tab-panel">
    <div class="grid-2">
      <div class="card">
        <div class="card-header">
          <span class="card-title">Log Worked Shift</span>
        </div>
        <form id="hoursForm" onsubmit="submitShiftHours(event)">
          <div class="form-group">
            <label>Date</label>
            <input type="date" id="hrDate" required />
          </div>

          <div class="form-group">
            <label>Manager</label>
            <input type="text" id="hrManager" placeholder="Type manager's name" required />
            <div class="pill-group">
              <span class="pill" onclick="setVal('hrManager','TAMI CHAIMOV')">TAMI CHAIMOV</span>
              <span class="pill" onclick="setVal('hrManager','AHMED MUSTAFA')">AHMED MUSTAFA</span>
            </div>
          </div>

          <div class="form-group">
            <label>Shift Type</label>
            <select id="hrShiftType" onchange="recalcShiftHours()">
              <option value="Pre Shift">Pre Shift (2.00 hrs)</option>
              <option value="1st Shift" selected>1st Shift (4.00 hrs)</option>
              <option value="2nd Shift">2nd Shift (4.00 hrs)</option>
              <option value="Cover">Cover (Custom hrs)</option>
            </select>
          </div>

          <div class="grid-2" style="gap:0.75rem;">
            <div class="form-group">
              <label>Custom / Cover Hours</label>
              <input type="number" step="0.25" min="0" id="hrCustom" placeholder="Optional (blank = standard)" oninput="recalcShiftHours()" />
            </div>
            <div class="form-group">
              <label>Calculated Shift Hours</label>
              <input type="text" id="hrCalculated" value="4.00" readonly style="background:#090d16; font-weight:700; color:var(--accent);" />
            </div>
          </div>

          <div class="form-group">
            <label>Notes</label>
            <input type="text" id="hrNotes" placeholder="Optional remarks or cover details" />
          </div>

