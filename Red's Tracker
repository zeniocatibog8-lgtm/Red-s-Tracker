          <button class="btn btn-outline btn-sm" onclick="exportLogsCSV()">Export CSV</button>
          <button class="btn btn-outline btn-sm" onclick="exportLogsJSON()">Export JSON</button>
          <button class="btn btn-danger btn-sm" onclick="resetSeedData()">Reset Sample Data</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Date</th>
              <th>Manager</th>
              <th>Shift Type</th>
              <th>Base Hrs</th>
              <th>Worked Hrs</th>
              <th>Notes</th>
              <th>Action</th>
