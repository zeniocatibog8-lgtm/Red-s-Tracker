  </section>
</main>

<div id="toast">Copied to clipboard!</div>

<script>
  const STORAGE_KEY_EOD = 'reds_tracker_eod_v1';
  const STORAGE_KEY_LOGS = 'reds_tracker_logs_v1';

  const SHIFT_DEFINITIONS = [
    { id: 'pre', title: 'PRE SHIFT PERFORMANCE REPORT', window: '10:00 - 12:00 EST', defaultHours: 2 },
    { id: '1st', title: '1ST SHIFT PERFORMANCE REPORT', window: '12:30 - 4:30 EST', defaultHours: 4 },
    { id: '1st_h1', title: '1ST SHIFT 1st half PERFORMANCE REPORT', window: '12:30 - 2:30 EST', defaultHours: 2 },
    { id: '1st_h2', title: '1ST SHIFT second half PERFORMANCE REPORT', window: '2:30 - 4:30 EST', defaultHours: 2 },
    { id: '2nd', title: '2ND SHIFT PERFORMANCE REPORT', window: '5:00 - 9:00 EST', defaultHours: 4 },
    { id: '2nd_h1', title: '2ND SHIFT 1st half PERFORMANCE REPORT', window: '5:00 - 7:00 EST', defaultHours: 2 },
    { id: '2nd_h2', title: '2ND SHIFT second half PERFORMANCE REPORT', window: '7:00 - 9:00 EST', defaultHours: 2 }
  ];

  // Default seeded EOD state matching Red's Tracker (11/16/2026)
  function getDefaultEodState() {
    return {
      date: '2026-11-16',
      hourly: {
        pre_1: 0, pre_2: 0,
        first_1: 53, first_2: 58, first_3: 56, first_4: 62,
        second_1: 0, second_2: 0, second_3: 0, second_4: 0
      },
      shifts: {
        pre:    { enabled: false, dials: 0,   manager: '',              confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 2 },
        '1st':  { enabled: true,  dials: 229, manager: 'TAMI CHAIMOV',  confirmed: 2, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 4 },
        '1st_h1':{ enabled: false, dials: 111, manager: '',             confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 2 },
        '1st_h2':{ enabled: false, dials: 118, manager: '',             confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 2 },
        '2nd':  { enabled: true,  dials: 0,   manager: 'AHMED MUSTAFA', confirmed: 1, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 4 },
        '2nd_h1':{ enabled: false, dials: 0,   manager: '',             confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 2 },
        '2nd_h2':{ enabled: false, dials: 0,   manager: '',             confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: 2 }
      }
    };
  }

  // Default seeded Worked Hours Logs matching Red's Tracker
  function getDefaultLogs() {
    return [
      {
        id: 'seed-1',
        timestamp: '2026-11-16 16:35:00',
        date: '2026-11-16',
        manager: 'TAMI CHAIMOV',
        shiftType: '1st Shift',
        baseHours: 4.00,
        workedHours: 4.00,
        notes: ''
      },
      {
        id: 'seed-2',
        timestamp: '2026-11-16 17:40:12',
        date: '2026-11-16',
        manager: 'AHMED MUSTAFA',
        shiftType: '1st Shift',
        baseHours: 4.00,
        workedHours: 4.00,
        notes: ''
      }
    ];
  }

  let eodState = JSON.parse(localStorage.getItem(STORAGE_KEY_EOD)) || getDefaultEodState();
  let shiftLogs = JSON.parse(localStorage.getItem(STORAGE_KEY_LOGS)) || getDefaultLogs();

  // Tab Navigation
  function switchTab(tabName) {
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + tabName).classList.add('active');
    event.target.classList.add('active');
    if (tabName === 'log') renderMasterLog();
    if (tabName === 'hours') renderLastSubmission();
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2400);
  }

  function copyText(elementId, message) {
    const el = document.getElementById(elementId);
    el.select();
    el.setSelectionRange(0, 99999);
    navigator.clipboard.writeText(el.value).then(() => showToast(message));
  }

  function setVal(id, val) {
    document.getElementById(id).value = val;
  }

  // ==================== EOD REPORT LOGIC ====================
  function initEodUI() {
    document.getElementById('eodDate').value = eodState.date;
    document.getElementById('d_pre_1').value = eodState.hourly.pre_1;
    document.getElementById('d_pre_2').value = eodState.hourly.pre_2;
    document.getElementById('d_1st_1').value = eodState.hourly.first_1;
    document.getElementById('d_1st_2').value = eodState.hourly.first_2;
    document.getElementById('d_1st_3').value = eodState.hourly.first_3;
    document.getElementById('d_1st_4').value = eodState.hourly.first_4;
    document.getElementById('d_2nd_1').value = eodState.hourly.second_1;
    document.getElementById('d_2nd_2').value = eodState.hourly.second_2;
    document.getElementById('d_2nd_3').value = eodState.hourly.second_3;
    document.getElementById('d_2nd_4').value = eodState.hourly.second_4;

    renderShiftCards();
    updateHourlyBadges();
    generateEodReport();
  }

  function renderShiftCards() {
    const container = document.getElementById('shiftCardsContainer');
    container.innerHTML = '';

    SHIFT_DEFINITIONS.forEach(def => {
      const st = eodState.shifts[def.id];
      const totalAppt = (Number(st.confirmed) || 0) + (Number(st.presetBooked) || 0) + (Number(st.presetConfirmed) || 0);

      const card = document.createElement('div');
      card.className = 'shift-card' + (st.enabled ? '' : ' disabled');
      card.innerHTML = `
        <div class="shift-card-header">
          <input type="checkbox" id="chk_${def.id}" ${st.enabled ? 'checked' : ''} onchange="toggleShift('${def.id}', this.checked)">
          <div>
            <div class="shift-card-title">${def.title}</div>
            <div style="font-size:0.75rem; color:var(--text-muted);">Shift: ${def.window} | Default: ${def.defaultHours} hrs</div>
          </div>
        </div>
        <div class="mini-grid">
          <div class="form-group">
            <label>Dials</label>
            <input type="number" min="0" value="${st.dials}" oninput="updateShiftField('${def.id}', 'dials', Number(this.value))">
          </div>
          <div class="form-group">
            <label>Manager's Name</label>
            <input type="text" value="${st.manager}" placeholder="e.g. TAMI CHAIMOV" oninput="updateShiftField('${def.id}', 'manager', this.value)">
          </div>
          <div class="form-group">
            <label>Confirmed Appt Booked</label>
            <input type="number" min="0" value="${st.confirmed}" oninput="updateShiftField('${def.id}', 'confirmed', Number(this.value))">
          </div>
          <div class="form-group">
            <label>Preset Appt Booked</label>
            <input type="number" min="0" value="${st.presetBooked}" oninput="updateShiftField('${def.id}', 'presetBooked', Number(this.value))">
          </div>
          <div class="form-group">
            <label>Preset Appt Confirmed</label>
            <input type="number" min="0" value="${st.presetConfirmed}" oninput="updateShiftField('${def.id}', 'presetConfirmed', Number(this.value))">
          </div>
          <div class="form-group">
            <label>System Issue Time Out</label>
            <input type="number" min="0" step="0.25" value="${st.sysTimeout}" oninput="updateShiftField('${def.id}', 'sysTimeout', Number(this.value))">
          </div>
          <div class="form-group">
            <label>Total Hours</label>
            <input type="number" min="0" step="0.25" value="${st.hours}" oninput="updateShiftField('${def.id}', 'hours', Number(this.value))">
          </div>
          <div class="form-group">
            <label>Total Appointment (Auto)</label>
            <input type="number" id="totAppt_${def.id}" value="${totalAppt}" readonly style="background:#090d16; color:var(--accent); font-weight:700;">
          </div>
        </div>
      `;
      container.appendChild(card);
    });
  }

  function toggleShift(id, checked) {
    eodState.shifts[id].enabled = checked;
    saveEodState();
    renderShiftCards();
    generateEodReport();
  }

  function updateShiftField(id, field, value) {
    eodState.shifts[id][field] = value;
    const st = eodState.shifts[id];
    const totalAppt = (Number(st.confirmed) || 0) + (Number(st.presetBooked) || 0) + (Number(st.presetConfirmed) || 0);
    const apptEl = document.getElementById('totAppt_' + id);
    if (apptEl) apptEl.value = totalAppt;
    saveEodState();
    generateEodReport();
  }

  function syncHourlyDials() {
    const h = eodState.hourly;
    h.pre_1 = Number(document.getElementById('d_pre_1').value) || 0;
    h.pre_2 = Number(document.getElementById('d_pre_2').value) || 0;
    h.first_1 = Number(document.getElementById('d_1st_1').value) || 0;
    h.first_2 = Number(document.getElementById('d_1st_2').value) || 0;
    h.first_3 = Number(document.getElementById('d_1st_3').value) || 0;
    h.first_4 = Number(document.getElementById('d_1st_4').value) || 0;
    h.second_1 = Number(document.getElementById('d_2nd_1').value) || 0;
    h.second_2 = Number(document.getElementById('d_2nd_2').value) || 0;
    h.second_3 = Number(document.getElementById('d_2nd_3').value) || 0;
    h.second_4 = Number(document.getElementById('d_2nd_4').value) || 0;

    eodState.shifts.pre.dials = h.pre_1 + h.pre_2;
    eodState.shifts['1st_h1'].dials = h.first_1 + h.first_2;
    eodState.shifts['1st_h2'].dials = h.first_3 + h.first_4;
    eodState.shifts['1st'].dials = eodState.shifts['1st_h1'].dials + eodState.shifts['1st_h2'].dials;
    eodState.shifts['2nd_h1'].dials = h.second_1 + h.second_2;
    eodState.shifts['2nd_h2'].dials = h.second_3 + h.second_4;
    eodState.shifts['2nd'].dials = eodState.shifts['2nd_h1'].dials + eodState.shifts['2nd_h2'].dials;

    updateHourlyBadges();
    saveEodState();
    renderShiftCards();
    generateEodReport();
  }

  function updateHourlyBadges() {
    const h = eodState.hourly;
    document.getElementById('preTotalBadge').textContent = `${h.pre_1 + h.pre_2} Dials`;
    document.getElementById('firstTotalBadge').textContent = `${h.first_1 + h.first_2 + h.first_3 + h.first_4} Dials`;
    document.getElementById('secondTotalBadge').textContent = `${h.second_1 + h.second_2 + h.second_3 + h.second_4} Dials`;
  }

  function saveEodState() {
    eodState.date = document.getElementById('eodDate').value;
    localStorage.setItem(STORAGE_KEY_EOD, JSON.stringify(eodState));
    generateEodReport();
  }

  function formatDisplayDate(isoDate) {
    if (!isoDate) return '';
    const [y, m, d] = isoDate.split('-');
    return `${m}/${d}/${y}`;
  }

  function generateEodReport() {
    const formattedDate = formatDisplayDate(eodState.date);
    let lines = [
      'EOD PERFORMANCE REPORT GENERATOR',
      'INSURANCE DEPARTMENT',
      `Date: ${formattedDate}`,
      ''
    ];

    let activeCount = 0;
    SHIFT_DEFINITIONS.forEach(def => {
      const st = eodState.shifts[def.id];
      if (!st.enabled) return;
      activeCount++;
      const totalAppt = (Number(st.confirmed) || 0) + (Number(st.presetBooked) || 0) + (Number(st.presetConfirmed) || 0);
      lines.push(`${def.title} (Shift: ${def.window}, Hours: ${def.defaultHours})`);
      lines.push(`DIALS: ${st.dials}`);
      lines.push(`MANAGERS NAME: ${st.manager.toUpperCase()}`);
      lines.push(`NUMBER OF CONFIRMED APPT BOOKED: ${st.confirmed}`);
      lines.push(`NUMBER OF PRESET APPT BOOKED: ${st.presetBooked}`);
      lines.push(`NUMBER OF PRESET APPT CONFIRMED: ${st.presetConfirmed}`);
      lines.push(`SYSTEM ISSUE TIME OUT: ${st.sysTimeout}`);
      lines.push(`TOTAL HOURS: ${st.hours}`);
      lines.push(`TOTAL APPOINTMENT: ${totalAppt}`);
      lines.push('');
    });

    if (activeCount === 0) {
      lines.push('(Check at least one shift box above to generate report blocks)');
    }

    document.getElementById('eodOutput').value = lines.join('\n').trim();
  }

  function resetEodCounters() {
    if (!confirm('Reset all EOD dials, appointments, and managers to zero/blank?')) return;
    eodState.hourly = { pre_1:0, pre_2:0, first_1:0, first_2:0, first_3:0, first_4:0, second_1:0, second_2:0, second_3:0, second_4:0 };
    SHIFT_DEFINITIONS.forEach(def => {
      eodState.shifts[def.id] = {
        enabled: false, dials: 0, manager: '', confirmed: 0, presetBooked: 0, presetConfirmed: 0, sysTimeout: 0, hours: def.defaultHours
      };
    });
    saveEodState();
    initEodUI();
    showToast('EOD counters reset');
  }

  // ==================== NOTE GENERATOR LOGIC ====================
  function copyCpToCb() {
    document.getElementById('noteBestCb').value = document.getElementById('noteCp').value;
    updateNoteOutput();
  }

  function updateNoteOutput() {
    const checkedTags = Array.from(document.querySelectorAll('.note-tag:checked')).map(cb => cb.value);
    const manager = document.getElementById('noteManager').value.trim().toUpperCase();
    const leadType = document.getElementById('noteLeadType').value.trim().toUpperCase();
    const state = document.getElementById('noteState').value.trim().toUpperCase();
    const name = document.getElementById('noteClientName').value.trim().toUpperCase();
    const email = document.getElementById('noteEmail').value.trim().toUpperCase();
    const cp = document.getElementById('noteCp').value.trim();
    const schedule = document.getElementById('noteSchedule').value.trim();
    const tz = document.getElementById('noteTimezone').value;
    const bestCb = document.getElementById('noteBestCb').value.trim();

    const headerTags = checkedTags.join(' | ');
    const noteLines = [
      headerTags ? headerTags : '',
      headerTags ? '' : null,
      `Manager's Name: ${manager}`,
      `Lead Type: ${leadType}`,
      `State: ${state}`,
      `Name: ${name}`,
      `Email: ${email}`,
      `CP#: ${cp}`,
      `SCHEDULE: ${schedule}`,
      `Time Zone: ${tz}`,
      `Best CB #: ${bestCb}`
    ].filter(line => line !== null);

    document.getElementById('noteOutput').value = noteLines.join('\n');
  }

  function resetNoteForm() {
    document.querySelectorAll('.note-tag').forEach(cb => cb.checked = false);
    ['noteManager','noteLeadType','noteState','noteClientName','noteEmail','noteCp','noteSchedule','noteBestCb'].forEach(id => {
      document.getElementById(id).value = '';
    });
    updateNoteOutput();
    showToast('Note form cleared');
  }

  // ==================== HOURS SUBMISSION & MASTER LOG LOGIC ====================
  function recalcShiftHours() {
    const type = document.getElementById('hrShiftType').value;
    const customVal = document.getElementById('hrCustom').value;
    let base = 4.00;
    if (type === 'Pre Shift') base = 2.00;
    else if (type === '1st Shift' || type === '2nd Shift') base = 4.00;
    else if (type === 'Cover') base = 0.00;

    const finalHrs = customVal !== '' ? Number(customVal) : base;
    document.getElementById('hrCalculated').value = finalHrs.toFixed(2);
  }

  function submitShiftHours(e) {
    e.preventDefault();
    const date = document.getElementById('hrDate').value;
    const manager = document.getElementById('hrManager').value.trim().toUpperCase();
    const shiftType = document.getElementById('hrShiftType').value;
    const customVal = document.getElementById('hrCustom').value;
    const notes = document.getElementById('hrNotes').value.trim();

    let baseHours = 4.00;
    if (shiftType === 'Pre Shift') baseHours = 2.00;
    else if (shiftType === 'Cover') baseHours = 0.00;

    const workedHours = customVal !== '' ? Number(customVal) : baseHours;

    const now = new Date();
    const ts = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}:${String(now.getSeconds()).padStart(2,'0')}`;

    const entry = {
      id: 'log-' + Date.now(),
      timestamp: ts,
      date,
      manager,
      shiftType,
      baseHours: Number(baseHours.toFixed(2)),
      workedHours: Number(workedHours.toFixed(2)),
      notes
    };

    shiftLogs.unshift(entry);
    localStorage.setItem(STORAGE_KEY_LOGS, JSON.stringify(shiftLogs));

    document.getElementById('hrCustom').value = '';
    document.getElementById('hrNotes').value = '';
    recalcShiftHours();
    renderLastSubmission();
    renderMasterLog();
    showToast(`Logged ${workedHours.toFixed(2)} hrs for ${manager}`);
  }

  function renderLastSubmission() {
    const box = document.getElementById('lastSubmissionBox');
    if (shiftLogs.length === 0) {
      box.innerHTML = '<p>No shifts logged yet.</p>';
      return;
    }
    const last = shiftLogs[0];
    box.innerHTML = `
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Date</th>
              <th>Manager</th>
              <th>Shift Type</th>
              <th>Base Hrs</th>
              <th>Worked Hrs</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>${last.timestamp}</td>
              <td>${last.date}</td>
              <td><strong>${last.manager}</strong></td>
              <td><span class="badge">${last.shiftType}</span></td>
              <td>${Number(last.baseHours).toFixed(2)}</td>
              <td><strong style="color:var(--accent);">${Number(last.workedHours).toFixed(2)}</strong></td>
              <td>${last.notes || '—'}</td>
            </tr>
          </tbody>
        </table>
      </div>
    `;
  }

  function getSundayOfWeek(dateStr) {
    const [y, m, d] = dateStr.split('-').map(Number);
    const dt = new Date(y, m - 1, d);
    const day = dt.getDay(); // 0 = Sunday
    dt.setDate(dt.getDate() - day);
    return `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;
  }

  function addDays(dateStr, days) {
    const [y, m, d] = dateStr.split('-').map(Number);
    const dt = new Date(y, m - 1, d);
    dt.setDate(dt.getDate() + days);
    return `${dt.getFullYear()}-${String(dt.getMonth()+1).padStart(2,'0')}-${String(dt.getDate()).padStart(2,'0')}`;
  }

  function renderMasterLog() {
    // 1. KPIs
    const totalHrs = shiftLogs.reduce((sum, item) => sum + Number(item.workedHours), 0);
    const totalShifts = shiftLogs.length;
    const coverCount = shiftLogs.filter(item => item.shiftType === 'Cover').length;
    const avgHrs = totalShifts > 0 ? totalHrs / totalShifts : 0;

    document.getElementById('kpiTotalHours').textContent = totalHrs.toFixed(2);
    document.getElementById('kpiTotalShifts').textContent = totalShifts;
    document.getElementById('kpiCoverCount').textContent = coverCount;
    document.getElementById('kpiAvgHours').textContent = avgHrs.toFixed(2);

    // 2. Manager Breakdown
    const mgrMap = {};
    shiftLogs.forEach(item => {
      const m = item.manager || 'UNKNOWN';
      if (!mgrMap[m]) {
        mgrMap[m] = { pre: 0, first: 0, second: 0, cover: 0, total: 0, count: 0 };
      }
      const hrs = Number(item.workedHours);
      if (item.shiftType === 'Pre Shift') mgrMap[m].pre += hrs;
      else if (item.shiftType === '1st Shift') mgrMap[m].first += hrs;
      else if (item.shiftType === '2nd Shift') mgrMap[m].second += hrs;
      else mgrMap[m].cover += hrs;

      mgrMap[m].total += hrs;
      mgrMap[m].count += 1;
    });

    const mgrBody = document.getElementById('managerBreakdownBody');
    mgrBody.innerHTML = '';
    let totPre = 0, tot1st = 0, tot2nd = 0, totCov = 0;

    Object.keys(mgrMap).forEach(mgr => {
      const d = mgrMap[mgr];
      totPre += d.pre; tot1st += d.first; tot2nd += d.second; totCov += d.cover;
      mgrBody.innerHTML += `
        <tr>
          <td><strong>${mgr}</strong></td>
          <td>${d.pre.toFixed(2)}</td>
          <td>${d.first.toFixed(2)}</td>
          <td>${d.second.toFixed(2)}</td>
          <td>${d.cover.toFixed(2)}</td>
          <td><strong style="color:var(--accent);">${d.total.toFixed(2)}</strong></td>
          <td>${d.count}</td>
        </tr>
      `;
    });

    mgrBody.innerHTML += `
      <tr style="background:rgba(255,255,255,0.04); font-weight:700;">
        <td>Total</td>
        <td>${totPre.toFixed(2)}</td>
        <td>${tot1st.toFixed(2)}</td>
        <td>${tot2nd.toFixed(2)}</td>
        <td>${totCov.toFixed(2)}</td>
        <td style="color:var(--accent);">${totalHrs.toFixed(2)}</td>
        <td>${totalShifts}</td>
      </tr>
    `;

    // 3. Weekly Summary (Sun - Sat)
    const weekMap = {};
    // Ensure current seeded weeks appear even if empty
    weekMap['2026-11-15'] = { pre:0, first:0, second:0, cover:0, total:0, shifts:0 };
    weekMap['2026-11-22'] = { pre:0, first:0, second:0, cover:0, total:0, shifts:0 };

    shiftLogs.forEach(item => {
      const sun = getSundayOfWeek(item.date);
      if (!weekMap[sun]) {
        weekMap[sun] = { pre:0, first:0, second:0, cover:0, total:0, shifts:0 };
      }
      const hrs = Number(item.workedHours);
      if (item.shiftType === 'Pre Shift') weekMap[sun].pre += hrs;
      else if (item.shiftType === '1st Shift') weekMap[sun].first += hrs;
      else if (item.shiftType === '2nd Shift') weekMap[sun].second += hrs;
      else weekMap[sun].cover += hrs;

      weekMap[sun].total += hrs;
      weekMap[sun].shifts += 1;
    });

    const weekBody = document.getElementById('weeklySummaryBody');
    weekBody.innerHTML = '';
    const sortedWeeks = Object.keys(weekMap).sort();
    sortedWeeks.forEach((sun, idx) => {
      const w = weekMap[sun];
      const sat = addDays(sun, 6);
      const label = idx === 0 ? `Week ${idx + 1} (Current)` : `Week ${idx + 1}`;
      weekBody.innerHTML += `
        <tr>
          <td><strong>${label}</strong></td>
          <td>${sun}</td>
          <td>${sat}</td>
          <td><strong style="color:var(--accent);">${w.total.toFixed(2)}</strong></td>
          <td>${w.shifts}</td>
          <td>${w.pre.toFixed(2)}</td>
          <td>${w.first.toFixed(2)}</td>
          <td>${w.second.toFixed(2)}</td>
          <td>${w.cover.toFixed(2)}</td>
        </tr>
      `;
    });

    // 4. Full History Table
    const search = document.getElementById('logSearch').value.toLowerCase();
    const filterShift = document.getElementById('logShiftFilter').value;

    const filtered = shiftLogs.filter(item => {
      const matchesText = item.manager.toLowerCase().includes(search) || (item.notes && item.notes.toLowerCase().includes(search));
      const matchesShift = !filterShift || item.shiftType === filterShift;
      return matchesText && matchesShift;
    });

    const fullBody = document.getElementById('fullLogBody');
    fullBody.innerHTML = '';
    filtered.forEach(item => {
      fullBody.innerHTML += `
        <tr>
          <td style="font-size:0.8rem; color:var(--text-muted);">${item.timestamp}</td>
          <td>${item.date}</td>
          <td><strong>${item.manager}</strong></td>
          <td><span class="badge">${item.shiftType}</span></td>
          <td>${Number(item.baseHours).toFixed(2)}</td>
          <td><strong style="color:var(--accent);">${Number(item.workedHours).toFixed(2)}</strong></td>
          <td>${item.notes || '—'}</td>
          <td><button class="btn btn-danger btn-sm" onclick="deleteLogEntry('${item.id}')">Delete</button></td>
        </tr>
      `;
    });
  }

  function deleteLogEntry(id) {
    shiftLogs = shiftLogs.filter(item => item.id !== id);
    localStorage.setItem(STORAGE_KEY_LOGS, JSON.stringify(shiftLogs));
    renderLastSubmission();
    renderMasterLog();
    showToast('Entry deleted');
  }

  function resetSeedData() {
    if (!confirm('Restore original Red\'s Tracker sample entries?')) return;
    shiftLogs = getDefaultLogs();
    localStorage.setItem(STORAGE_KEY_LOGS, JSON.stringify(shiftLogs));
    renderLastSubmission();
    renderMasterLog();
    showToast('Sample data restored');
  }

  function exportLogsCSV() {
    const headers = ['Timestamp','Date','Manager','Shift Type','Base Hours','Worked Hours','Notes'];
    const rows = shiftLogs.map(r => [r.timestamp, r.date, `"${r.manager}"`, r.shiftType, r.baseHours, r.workedHours, `"${(r.notes || '').replace(/"/g,'""')}"`].join(','));
    const csv = [headers.join(','), ...rows].join('\n');
    downloadFile(csv, 'reds-tracker-hours.csv', 'text/csv');
  }

  function exportLogsJSON() {
    const payload = JSON.stringify({ eodState, shiftLogs }, null, 2);
    downloadFile(payload, 'reds-tracker-backup.json', 'application/json');
  }

  function downloadFile(content, filename, mime) {
    const blob = new Blob([content], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Initialize Everything on Load
  window.addEventListener('DOMContentLoaded', () => {
    document.getElementById('hrDate').value = '2026-11-16';
    initEodUI();
    updateNoteOutput();
    renderLastSubmission();
    renderMasterLog();
  });
</script>
</body>
</html>
